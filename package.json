{
  "name": "local-leads",
  "version": "0.1.0",
  "description": "Local Leads: поиск локального бизнеса без сайта",
  "main": "./out/main/index.js",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "better-sqlite3": "13.2.0",
    "grammy": "1.46.0",
    "leaflet": "1.9.4",
    "libphonenumber-js": "1.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cross-env": "10.1.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
